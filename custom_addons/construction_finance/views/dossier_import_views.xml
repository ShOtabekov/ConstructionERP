<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dossier_import_form" model="ir.ui.view">
        <field name="name">construction.dossier.import.form</field>
        <field name="model">construction.dossier.import</field>
        <field name="arch" type="xml">
            <form string="Импорт договоров из досье">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Файл Excel в формате «Досье»: №, Сана, Ному насаб, паспорт (силсила, кем и когда выдан),
                        Ҷои истиқомат, Блок, Этаж, Хуҷра, м², нарх, миқдор. Сначала «Проверить», затем «Импортировать».<br/>
                        <b>Как бронь</b>: квартиры бронируются на клиентов, договор, график и оплаты оформляет финдиректор
                        кнопкой «Продать» — № и дата договора, цена и площадь подставятся из досье.
                    </div>
                    <group>
                        <field name="project_id"/>
                        <field name="mode" widget="radio"/>
                        <field name="reserve_days" invisible="mode != 'reservation'"/>
                        <field name="file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="ready_count" invisible="1"/>
                        <field name="done" invisible="1"/>
                    </group>
                    <field name="preview_html" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_check" type="object" string="Проверить" class="btn-secondary"
                            invisible="not file"/>
                    <button name="action_import" type="object" string="Импортировать" class="btn-primary"
                            invisible="ready_count == 0 or done"
                            confirm="Договоры будут созданы, квартиры станут «Продана». Продолжить?"/>
                    <button name="action_undo_contracts" type="object" string="Отменить ранее перенесённые договоры"
                            class="btn-link text-danger"
                            confirm="Договоры, перенесённые из досье (без оплат и графиков), будут удалены, квартиры станут свободными. Продолжить?"/>
                    <button string="Закрыть" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dossier_import" model="ir.actions.act_window">
        <field name="name">Импорт договоров из досье</field>
        <field name="res_model">construction.dossier.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_dossier_import" name="Импорт договоров из Excel"
              parent="construction_sales.menu_construction_sales"
              action="action_dossier_import" sequence="90"
              groups="base.group_system,construction_finance.group_finance_user"/>

    <record id="view_reservation_form_dossier" model="ir.ui.view">
        <field name="name">construction.reservation.form.dossier</field>
        <field name="model">construction.reservation</field>
        <field name="inherit_id" ref="construction_sales.view_construction_reservation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notes']" position="before">
                <group string="Из досье" invisible="not dossier_contract_no">
                    <field name="dossier_contract_no" readonly="1"/>
                    <field name="dossier_date" readonly="1"/>
                    <field name="dossier_price_per_sqm" readonly="1"/>
                    <field name="dossier_area" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
