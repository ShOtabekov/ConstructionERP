<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payment_schedule_list" model="ir.ui.view">
        <field name="name">construction.payment.schedule.list</field>
        <field name="model">construction.payment.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="exchange_rate"/>
                <field name="amount_usd"/>
                <field name="paid_usd"/>
                <field name="balance_usd"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_payment_schedule_form" model="ir.ui.view">
        <field name="name">construction.payment.schedule.form</field>
        <field name="model">construction.payment.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="plan_id"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="exchange_rate"/>
                        <field name="amount_usd"/>
                        <field name="paid_usd"/>
                        <field name="balance_usd"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_payment_schedules" model="ir.actions.act_window">
        <field name="name">Payment Schedule</field>
        <field name="res_model">construction.payment.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
