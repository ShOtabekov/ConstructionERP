<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_construction_payment_list" model="ir.ui.view">
        <field name="name">construction.payment.list</field>
        <field name="model">construction.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="schedule_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="exchange_rate"/>
                <field name="amount_usd"/>
                <field name="method_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_construction_payment_form" model="ir.ui.view">
        <field name="name">construction.payment.form</field>
        <field name="model">construction.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_payment_receipt)d"
                            type="action"
                            string="?????? ?????????"
                            class="btn-primary"
                            invisible="state != 'posted'"/>
                    <button name="action_post" type="object" string="Post Payment"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="construction_finance.group_finance_manager,base.group_system"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="schedule_id" readonly="state != 'draft'"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="method_id" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="exchange_rate" readonly="state != 'draft'"/>
                            <field name="currency_usd_id" invisible="1"/>
                            <field name="amount_usd"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group><field name="notes" readonly="state != 'draft'"/></group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">construction.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
