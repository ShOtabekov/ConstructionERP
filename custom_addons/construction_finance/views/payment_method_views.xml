<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payment_method_list" model="ir.ui.view">
        <field name="name">construction.payment.method.list</field>
        <field name="model">construction.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_payment_method_form" model="ir.ui.view">
        <field name="name">construction.payment.method.form</field>
        <field name="model">construction.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_payment_methods" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">construction.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
