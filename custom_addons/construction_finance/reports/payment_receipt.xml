<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_payment_receipt" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">construction.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_finance.report_payment_receipt</field>
        <field name="report_file">construction_finance.report_payment_receipt</field>
        <field name="print_report_name">'Receipt - %s' % (object.name)</field>
    </record>

    <template id="report_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>PAYMENT RECEIPT</h2>
                        <h3><span t-field="o.name"/></h3>

                        <table class="table table-sm">
                            <tr>
                                <td><strong>Payment Date</strong></td>
                                <td><span t-field="o.payment_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Buyer</strong></td>
                                <td><span t-field="o.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Contract</strong></td>
                                <td><span t-field="o.contract_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Apartment</strong></td>
                                <td><span t-field="o.contract_id.apartment_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Payment Schedule</strong></td>
                                <td><span t-field="o.schedule_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Payment Method</strong></td>
                                <td><span t-field="o.method_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Reference</strong></td>
                                <td><span t-field="o.reference"/></td>
                            </tr>
                        </table>

                        <div class="mt-4 mb-4">
                            <h3>
                                Amount:
                                <span t-field="o.amount"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </h3>
                        </div>

                        <p>
                            <strong>Payment Status:</strong>
                            <span t-field="o.state"/>
                        </p>

                        <div class="row mt-5">
                            <div class="col-6">
                                Cashier: ____________________
                            </div>
                            <div class="col-6">
                                Buyer: ____________________
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
