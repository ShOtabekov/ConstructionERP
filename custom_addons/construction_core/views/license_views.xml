<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_license_wizard_form" model="ir.ui.view">
        <field name="name">construction.license.wizard.form</field>
        <field name="model">construction.license.wizard</field>
        <field name="arch" type="xml">
            <form string="Лицензия">
                <sheet>
                    <div class="oe_title"><h1>Лицензия «Строительная ERP»</h1></div>
                    <field name="status_html" nolabel="1"/>
                    <group>
                        <field name="machine_code" readonly="1" widget="CopyClipboardChar"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        1. Отправьте разработчику <b>код компьютера</b> (кнопка копирования справа от кода).<br/>
                        2. Вставьте полученный ключ ниже и нажмите «Активировать».<br/>
                        Разработчик: Actually_team, Telegram / WhatsApp +992 92 609 80 04
                    </div>
                    <group>
                        <field name="license_key" placeholder="Вставьте ключ сюда" rows="4"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_activate" type="object" string="Активировать" class="btn-primary"/>
                    <button string="Закрыть" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_license_wizard" model="ir.actions.act_window">
        <field name="name">Лицензия</field>
        <field name="res_model">construction.license.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Отдельный пункт, когда лицензии нет (всё остальное скрыто) -->
    <menuitem id="menu_license_root" name="Лицензия" sequence="4"
              action="action_license_wizard" groups="base.group_user"/>

    <!-- Внутри «Строительной ERP», когда лицензия действует -->
    <menuitem id="menu_license" name="Лицензия" parent="menu_construction_root"
              action="action_license_wizard" sequence="999" groups="base.group_user"/>

    <record id="ir_cron_license_touch" model="ir.cron">
        <field name="name">Строительная ERP: проверка лицензии</field>
        <field name="model_id" ref="model_construction_license"/>
        <field name="state">code</field>
        <field name="code">model._cron_touch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <function model="construction.license" name="_cron_touch"/>
</odoo>
