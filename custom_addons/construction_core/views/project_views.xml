<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_construction_project_list" model="ir.ui.view">
        <field name="name">construction.project.list</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list string="Construction Projects">
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form string="Construction Project">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_project" model="ir.actions.act_window">
        <field name="name">Construction Projects</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_construction_root"
        name="Construction ERP"
        sequence="5"
        groups="base.group_user"
    />

    <menuitem
        id="menu_construction_projects"
        name="Projects"
        parent="menu_construction_root"
        action="action_construction_project"
        sequence="10"
    />
</odoo>
