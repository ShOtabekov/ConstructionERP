<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_core.ApartmentChessboard">
        <div class="o_apartment_chessboard" t-att-class="{ 'o_card_open': state.selectedId }">
            <div class="o_chess_main">

                <!-- Header -->
                <div class="o_chess_header">
                    <h2 class="mb-0">Шахматка</h2>
                    <div class="o_chess_stats">
                        <span class="o_stat"><b t-esc="stats.total"/> всего</span>
                        <span class="o_stat o_state_free"><b t-esc="stats.free"/> свободно</span>
                        <span class="o_stat o_state_reserved"><b t-esc="stats.reserved"/> бронь</span>
                        <span class="o_stat o_state_sold"><b t-esc="stats.sold"/> продано</span>
                        <span t-if="stats.blocked" class="o_stat o_state_blocked"><b t-esc="stats.blocked"/> блок</span>
                    </div>
                </div>

                <!-- Filters -->
                <div class="o_chess_filters">
                    <select t-if="projects.length > 1" class="form-select o_filter_project"
                            t-on-change="onProjectChange" t-att-value="state.project">
                        <option value="">Все проекты</option>
                        <t t-foreach="projects" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-esc="item.name"/>
                        </t>
                    </select>

                    <div class="o_chips" t-if="buildings.length > 1">
                        <button class="o_chip" t-att-class="{ active: !state.building }"
                                t-on-click="() => this.setValue('building', '')">Все блоки</button>
                        <t t-foreach="buildings" t-as="item" t-key="item.id">
                            <button class="o_chip" t-att-class="{ active: state.building == item.id }"
                                    t-on-click="() => this.setFilter('building', String(item.id))"
                                    t-esc="item.name"/>
                        </t>
                    </div>

                    <div class="o_chips">
                        <t t-foreach="roomFilters" t-as="item" t-key="item.value">
                            <button class="o_chip" t-att-class="{ active: state.rooms === item.value }"
                                    t-on-click="() => this.setValue('rooms', item.value)"
                                    t-esc="item.label"/>
                        </t>
                    </div>

                    <div class="o_chips">
                        <t t-foreach="statusList" t-as="item" t-key="item.value">
                            <button class="o_chip o_chip_status"
                                    t-att-class="statusChipClass(item.value)"
                                    t-on-click="() => this.setFilter('status', item.value)">
                                <i class="o_dot"/> <t t-esc="item.label"/>
                            </button>
                        </t>
                    </div>

                    <input type="search" class="form-control o_filter_search"
                           placeholder="№ квартиры"
                           t-att-value="state.search" t-on-input="onSearchInput"/>

                    <button t-if="hasHighlightFilter or state.building or state.project"
                            class="btn btn-link btn-sm" t-on-click="clearFilters">
                        Сбросить
                    </button>
                    <span t-if="hasHighlightFilter" class="text-muted small">
                        Подходит: <b t-esc="matchCount"/>
                    </span>
                </div>

                <!-- Board -->
                <t t-if="state.loading">
                    <div class="text-center p-5 text-muted">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <p class="mt-2">Загрузка квартир…</p>
                    </div>
                </t>
                <t t-elif="state.error">
                    <div class="alert alert-danger m-3">
                        <t t-esc="state.error"/>
                        <button class="btn btn-sm btn-outline-danger ms-2" t-on-click="loadApartments">
                            Повторить
                        </button>
                    </div>
                </t>
                <t t-elif="!scopeApartments.length">
                    <div class="alert alert-info m-3">Квартиры не найдены.</div>
                </t>
                <t t-else="">
                    <div class="o_chess_blocks">
                        <t t-foreach="blocks" t-as="block" t-key="block.id">
                            <section class="o_chess_block">
                                <div class="o_block_title">
                                    <strong t-esc="block.name"/>
                                    <span class="text-muted">
                                        свободно <b t-esc="block.free"/> из <t t-esc="block.total"/>
                                    </span>
                                </div>
                                <table class="o_block_grid">
                                    <tbody>
                                        <t t-foreach="block.floors" t-as="floor" t-key="floor.id">
                                            <tr>
                                                <th class="o_floor_label" t-esc="floor.number"/>
                                                <td>
                                                    <div class="o_floor_units">
                                                        <t t-foreach="floor.units" t-as="apartment" t-key="apartment.id">
                                                            <button type="button"
                                                                    t-att-class="unitClass(apartment)"
                                                                    t-att-title="unitTitle(apartment)"
                                                                    t-on-click="() => this.selectUnit(apartment)">
                                                                <span class="o_unit_number" t-esc="apartment.number"/>
                                                                <span class="o_unit_meta" t-esc="unitMeta(apartment)"/>
                                                            </button>
                                                        </t>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </section>
                        </t>
                    </div>
                </t>
            </div>

            <!-- Side card -->
            <aside t-if="state.selectedId" class="o_chess_card">
                <button class="btn-close o_card_close" title="Закрыть" t-on-click="closeCard"/>
                <t t-if="state.cardLoading and !state.card">
                    <div class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin"/></div>
                </t>
                <t t-elif="state.card">
                    <t t-set="card" t-value="state.card"/>
                    <div t-attf-class="o_card_status o_state_#{card.state}">
                        <i class="o_dot"/> <t t-esc="card.state_label"/>
                    </div>
                    <h3 class="o_card_title"><t t-esc="card.unit_type === 'shop' ? 'Магазин' : 'Кв.'"/> <t t-esc="card.number"/></h3>
                    <div class="text-muted mb-3">
                        <t t-esc="card.building"/> · <t t-esc="card.floor"/> этаж
                        <t t-if="card.entrance"> · <t t-esc="card.entrance"/></t>
                    </div>

                    <div t-if="card.plan" class="o_card_plan">
                        <a t-att-href="card.plan.url" target="_blank" title="Открыть план">
                            <img t-att-src="card.plan.url" alt="План этажа"/>
                        </a>
                        <span class="o_plan_marker"
                              t-attf-style="left: {{card.plan.x}}%; top: {{card.plan.y}}%;"/>
                    </div>

                    <div class="o_card_facts">
                        <div t-if="card.unit_type !== 'shop'"><span>Комнат</span><b t-esc="card.rooms"/></div>
                        <div><span>Площадь</span><b><t t-esc="card.area_total"/> м²</b></div>
                        <div t-if="card.area_living"><span>Жилая</span><b><t t-esc="card.area_living"/> м²</b></div>
                        <div><span>Цена за м²</span><b t-esc="money(card.price_per_sqm_usd)"/></div>
                    </div>

                    <div class="o_card_price">
                        <div class="o_price_main" t-esc="money(card.total_price_usd)"/>
                        <div t-if="card.total_price_tjs" class="text-muted">
                            ≈ <t t-esc="money(card.total_price_tjs, 'TJS')"/>
                            (курс <t t-esc="card.usd_tjs_rate"/>)
                        </div>
                    </div>

                    <dl t-if="card.info.length" class="o_card_info">
                        <t t-foreach="card.info" t-as="line" t-key="line_index">
                            <dt t-esc="line.label"/>
                            <dd t-esc="line.value"/>
                        </t>
                    </dl>

                    <div class="o_card_actions">
                        <t t-foreach="card.actions" t-as="act" t-key="act.method">
                            <button t-att-class="actionClass(act)"
                                    t-att-disabled="state.busy"
                                    t-on-click="() => this.runAction(act.method)"
                                    t-esc="act.label"/>
                        </t>
                    </div>
                </t>
            </aside>
        </div>
    </t>
</templates>
